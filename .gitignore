## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015/2017/2019 cache files
.vs/
*.vs/

# MSSQL / SQLite Database files
*.mdf
*.ldf
*.ndf
*.db
*.sqlite
*.sqlite3

# NuGet Packages
*.nupkg
**/packages/*

# OS generated files
.DS_Store
Thumbs.db