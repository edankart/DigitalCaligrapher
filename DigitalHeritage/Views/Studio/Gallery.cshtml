@model IEnumerable<DigitalHeritage.Application.DTOs.ArtifactDto>

@{
    ViewData["Title"] = "Gallery";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #fafafa;
        color: #1a1a1a;
    }

    .gallery-wrapper {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .gallery-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .gallery-header h1 {
            font-weight: 600;
            font-size: 2.5rem;
            letter-spacing: -0.02em;
        }

    /* Filter Buttons */
    .filter-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 50px;
    }

    .filter-btn {
        background: #ffffff;
        border: 1px solid #eaeaea;
        padding: 10px 24px;
        border-radius: 30px;
        font-size: 0.95rem;
        font-weight: 600;
        color: #666;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .filter-btn:hover {
            background: #f0f0f0;
            color: #1a1a1a;
        }

        .filter-btn.active {
            background: #1a1a1a;
            color: #ffffff;
            border-color: #1a1a1a;
        }

    /* Masonry-like Grid */
    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 30px;
    }

    .artifact-card {
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
        border: 1px solid #eaeaea;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        cursor: pointer; /* Indicates it's clickable */
    }

        .artifact-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

    .artifact-image {
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        background-color: #fcfcfc;
        padding: 20px;
    }

    .artifact-info {
        padding: 15px 20px;
        border-top: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .artifact-title {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .artifact-date {
        font-size: 0.8rem;
        color: #888;
    }

    .btn-delete {
        background: none;
        border: none;
        color: #e63946;
        cursor: pointer;
        padding: 5px;
        opacity: 0.5;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
    }

        .btn-delete:hover {
            opacity: 1;
        }

    .empty-state {
        text-align: center;
        padding: 100px 20px;
        color: #666;
        display: none; /* Hidden by default, shown via JS if empty */
    }

    .btn-back {
        display: inline-block;
        margin-top: 20px;
        color: #e63946;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-back:hover {
            text-decoration: underline;
        }

    /* --- MODAL STYLES --- */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.8);
        backdrop-filter: blur(5px);
        opacity: 0;
        transition: opacity 0.3s ease;
        align-items: center;
        justify-content: center;
    }

        .modal.show {
            display: flex;
            opacity: 1;
        }

    .modal-content {
        background-color: #faf9f6;
        padding: 40px;
        border-radius: 20px;
        max-width: 800px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        transform: scale(0.9);
        transition: transform 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .modal.show .modal-content {
        transform: scale(1);
    }

    .modal-image {
        width: 100%;
        max-height: 500px;
        object-fit: contain;
        border-radius: 12px;
        margin-bottom: 30px;
        border: 1px solid #eaeaea;
        background: #ffffff;
        padding: 10px;
    }

    .modal-info {
        text-align: center;
        width: 100%;
    }

        .modal-info h2 {
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .modal-info p {
            color: #666;
            margin-bottom: 5px;
            font-size: 0.95rem;
        }

    .close-btn {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 2rem;
        color: #666;
        cursor: pointer;
        transition: color 0.2s;
        line-height: 1;
    }

        .close-btn:hover {
            color: #e63946;
        }

    @@media (max-width: 768px) {
        .filter-buttons {
            flex-wrap: wrap;
        }

        .modal-content {
            padding: 20px;
        }
    }
</style>

<div class="gallery-wrapper">
    <div class="gallery-header fade-up-element delay-1">
        <h1 data-en="Masterpiece Gallery" data-cn="杰作画廊">Masterpiece Gallery</h1>
        <p style="color: #666; margin-top: 10px;" data-en="A digital museum of your heritage." data-cn="您的数字遗产博物馆。">A digital museum of your heritage.</p>
        <a href="/Studio" class="btn-back" data-en="&larr; Back to Studio" data-cn="&larr; 返回工作室">&larr; Back to Studio</a>
    </div>

    <!-- Filters -->
    <div class="filter-buttons fade-up-element delay-2">
        <button class="filter-btn active" data-filter="all" data-en="All" data-cn="全部">All</button>
        <button class="filter-btn" data-filter="generator" data-en="Generator Mode" data-cn="生成器模式">Generator Mode</button>
        <button class="filter-btn" data-filter="brush" data-en="Ink Brush Mode" data-cn="水墨笔模式">Ink Brush Mode</button>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="gallery-grid fade-up-element delay-3" id="galleryGrid">
            @foreach (var artifact in Model)
            {
                // Extract mode from settings JSON to use for filtering
                var mode = "generator"; // Default
                if (artifact.GenerationSettings != null && artifact.GenerationSettings.Contains("brush")) { mode = "brush"; }

                <div class="artifact-card" data-mode="@mode" onclick="openModal(this)">
                    <!-- Image is stored as base64 string in DB -->
                    <img src="@artifact.ImageBase64" alt="Pattern" class="artifact-image">

                    <div class="artifact-info">
                        <div>
                            <div class="artifact-title">@artifact.Title</div>
                            <div class="artifact-date">@artifact.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </div>

                        <!-- Delete Button -->
                        <button class="btn-delete" data-id="@artifact.Id" title="Delete" onclick="event.stopPropagation(); deleteArtifact(this);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4z" />
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="empty-state" id="emptyState">
        <h3 data-en="No masterpieces found." data-cn="未找到杰作。">No masterpieces found.</h3>
        <p data-en="Try changing the filter or create a new one in the studio." data-cn="尝试更改过滤器或在工作室中创建一个新的。">Try changing the filter or create a new one in the studio.</p>
    </div>
</div>

<!-- The Modal -->
<div id="imageModal" class="modal">
    <div class="modal-content">
        <span class="close-btn" onclick="closeModal()">&times;</span>
        <img src="" alt="Masterpiece" class="modal-image" id="modalImage">
        <div class="modal-info">
            <h2 id="modalTitle">Masterpiece</h2>
            <p id="modalDate"></p>
            <p id="modalMode" style="color: #e63946; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem; margin-top: 10px;"></p>

            <!-- NEW: Share button inside modal -->
            <button id="shareModalBtn" style="margin-top: 20px; background: #1a1a1a; color: #fff; border: none; padding: 12px 24px; border-radius: 30px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;" onclick="shareArtifact()">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z" />
                </svg>
                Share
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- FILTER LOGIC ---
        const filterBtns = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.artifact-card');
        const emptyState = document.getElementById('emptyState');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                // Update active button
                filterBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.getAttribute('data-filter');
                let visibleCount = 0;

                cards.forEach(card => {
                    const mode = card.getAttribute('data-mode');
                    if (filter === 'all' || filter === mode) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Show empty state if no cards match
                if (visibleCount === 0 && cards.length > 0) {
                    emptyState.style.display = 'block';
                } else {
                    emptyState.style.display = 'none';
                }
            });
        });

        // --- MODAL LOGIC ---
        const modal = document.getElementById('imageModal');
        const modalImage = document.getElementById('modalImage');
        const modalTitle = document.getElementById('modalTitle');
        const modalDate = document.getElementById('modalDate');
        const modalMode = document.getElementById('modalMode');

        function openModal(cardElement) {
            const img = cardElement.querySelector('.artifact-image').src;
            const title = cardElement.querySelector('.artifact-title').innerText;
            const date = cardElement.querySelector('.artifact-date').innerText;
            const mode = cardElement.getAttribute('data-mode');

            modalImage.src = img;
            modalTitle.innerText = title;
            modalDate.innerText = date;

            // Translate mode text
            const lang = localStorage.getItem('siteLanguage') || 'en';
            if (lang === 'cn') {
                modalMode.innerText = (mode === 'brush') ? '水墨笔模式' : '生成器模式';
            } else {
                modalMode.innerText = (mode === 'brush') ? 'Ink Brush Mode' : 'Generator Mode';
            }

            modal.classList.add('show');
        }

        function closeModal() {
            modal.classList.remove('show');
        }

        // Close modal when clicking outside the content
        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        // --- DELETE LOGIC ---
        async function deleteArtifact(btn) {
            if (!confirm("Are you sure you want to delete this masterpiece?")) return;

            const id = btn.getAttribute('data-id');

            try {
                const response = await fetch(`/Studio/Delete/${id}`, {
                    method: 'POST'
                });

                if (response.ok) {
                    const card = btn.closest('.artifact-card');
                    card.style.transform = 'scale(0.8)';
                    card.style.opacity = '0';
                    setTimeout(() => card.remove(), 300);
                } else {
                    alert("Error deleting artifact.");
                }
            } catch (err) {
                console.error(err);
                alert("Network error.");
            }
        }
                function shareArtifact() {
            const shareText = "Check out this masterpiece from Digital Heritage!";
            const shareUrl = window.location.origin + '/Studio/Gallery';

            if (navigator.share) {
                navigator.share({
                    title: 'Digital Heritage Gallery',
                    text: shareText,
                    url: shareUrl
                }).catch((error) => console.log('Error sharing', error));
            } else {
                const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
                window.open(twitterUrl, '_blank');
            }
        }
    </script>
}