@{
    ViewData["Title"] = "Pattern Studio";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;800&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #fafafa;
        color: #1a1a1a;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .studio-wrapper {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .header-section {
        text-align: center;
        margin-bottom: 50px;
    }

        .header-section h1 {
            font-weight: 600;
            font-size: 2.5rem;
            letter-spacing: -0.02em;
            margin-bottom: 10px;
        }

    .studio-layout {
        display: flex;
        gap: 40px;
        align-items: flex-start;
    }

    .controls-panel {
        flex: 1;
        background: #ffffff;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
        border: 1px solid #eaeaea;
    }

    .control-group {
        margin-bottom: 28px;
    }

    .control-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

        .control-header label {
            font-weight: 600;
            font-size: 0.9rem;
            color: #333;
        }

        .control-header span {
            font-size: 0.85rem;
            color: #666;
            background: #f0f0f0;
            padding: 2px 8px;
            border-radius: 4px;
        }

    #downloadBtn:hover {
        background-color: #f0f0f0 !important;
        color: #1a1a1a !important;
        border-color: #1a1a1a !important;
    }

    input[type="range"] {
        -webkit-appearance: none;
        width: 100%;
        background: transparent;
    }

        input[type="range"]:focus {
            outline: none;
        }

        input[type="range"]::-webkit-slider-runnable-track {
            width: 100%;
            height: 4px;
            cursor: pointer;
            background: #e0e0e0;
            border-radius: 2px;
        }

        input[type="range"]::-webkit-slider-thumb {
            height: 18px;
            width: 18px;
            border-radius: 50%;
            background: #1a1a1a;
            cursor: pointer;
            -webkit-appearance: none;
            margin-top: -7px;
            transition: transform 0.2s ease;
        }

            input[type="range"]::-webkit-slider-thumb:hover {
                transform: scale(1.2);
            }

    .btn-save {
        width: 100%;
        background-color: #e63946;
        color: #ffffff;
        border: none;
        padding: 16px;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-top: 10px;
    }

        .btn-save:hover {
            background-color: #d62828;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(230, 57, 70, 0.2);
        }

    .status-msg {
        margin-top: 20px;
        text-align: center;
        font-size: 0.9rem;
        min-height: 20px;
        font-weight: 500;
    }

    .canvas-panel {
        flex: 1.5;
        display: flex;
        justify-content: center;
        align-items: center;
        background: #ffffff;
        padding: 20px;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
        border: 1px solid #eaeaea;
        min-height: 640px;
        position: relative;
        overflow: hidden;
    }

    #canvasWrapper {
        position: relative;
        width: 600px;
        height: 600px;
        background: #faf9f6;
        border-radius: 8px;
        overflow: hidden;
    }

        #canvasWrapper canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }

    #pencilCanvas {
        pointer-events: none;
        z-index: 10;
    }

    .center-dot {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
        height: 8px;
        background-color: #e63946;
        border-radius: 50%;
        z-index: 1;
        box-shadow: 0 0 6px rgba(230, 57, 70, 0.3);
    }

    @@media (max-width: 950px) {
        .center-dot {
            display: none !important;
        }
    }

    @@media (max-width: 768px) {
        .studio-layout {
            flex-direction: column;
        }

        .controls-panel, .canvas-panel {
            width: 100%;
        }

        .canvas-panel {
            min-height: 400px;
        }

        #canvasWrapper {
            width: 100%;
            max-width: 600px;
            height: auto;
            aspect-ratio: 1/1;
        }
    }

    .hero-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 900;
        font-size: 5.5rem;
        letter-spacing: -0.03em;
        margin-bottom: 30px;
        line-height: 1.1;
        color: #1a1a1a;
    }

    .rgb-text {
        background: linear-gradient(90deg, #00d2ff, #3a7bd5, #00d2ff);
        background-size: 200% auto;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shine 3s linear infinite;
    }

    @@keyframes shine {
        to {
            background-position: 200% center;
        }
    }

    .header-section p {
        margin-top: 30px;
        margin-bottom: 50px;
        font-size: 1.2rem;
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 3.5rem;
        }
    }

    #shareBtn:hover {
        background-color: #f0f0f0;
        border-color: #1a1a1a;
        color: #1a1a1a;
    }
</style>

<div class="studio-wrapper">
    <div style="background-color: #fff8f8; border: 1px solid #ffe3e3; border-radius: 12px; padding: 20px 30px; margin-bottom: 40px; display: flex; align-items: center; justify-content: space-between;">
        <div>
            <h4 style="margin: 0 0 5px 0; color: #e63946; font-weight: 600;" data-en="What is this?" data-cn="这是什么？">What is this?</h4>
            <p style="margin: 0; color: #666; font-size: 0.95rem;" data-en="This generative tool creates symmetrical patterns inspired by traditional mandalas and ethnic ornaments." data-cn="这个生成工具创建了受传统曼陀罗和民族装饰启发的对称图案。">This generative tool creates symmetrical patterns inspired by traditional mandalas and ethnic ornaments.</p>
        </div>
    </div>
    <div class="header-section fade-up-element delay-1">
        <h1 class="hero-title">
            <span data-en="Pattern" data-cn="图案">Pattern</span>
            <span class="rgb-text" data-en="Studio" data-cn="工作室">Studio</span>
        </h1>
        <p data-en="Blend ancient symmetry with modern code. Design, draw, and preserve your digital heritage." data-cn="将古老的对称美学与现代代码相结合。设计、绘制并保存您的数字遗产。">
            Blend ancient symmetry with modern code. Design, draw, and preserve your digital heritage.
        </p>
    </div>

    <div class="studio-layout">
        <div class="controls-panel fade-up-element delay-2">
            <div style="display: flex; gap: 10px; margin-bottom: 30px; border-bottom: 1px solid #eaeaea; padding-bottom: 15px;">
                <button id="tabGenerator" class="tab-btn active" style="flex: 1; padding: 10px; border: none; background: #1a1a1a; color: white; border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.2s;" data-en="Generator" data-cn="生成器">Generator</button>
                <button id="tabBrush" class="tab-btn" style="flex: 1; padding: 10px; border: none; background: #f0f0f0; color: #1a1a1a; border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.2s;" data-en="Ink Brush" data-cn="水墨笔">Ink Brush</button>
            </div>

            <div id="panelGenerator">
                <div class="control-group">
                    <div class="control-header"><label data-en="Petals Count" data-cn="花瓣数量">Petals Count</label><span id="valPetals">8</span></div>
                    <input type="range" id="petals" min="3" max="24" value="8">
                </div>
                <div class="control-group">
                    <div class="control-header"><label data-en="Line Thickness" data-cn="线条粗细">Line Thickness</label><span id="valStroke">2</span></div>
                    <input type="range" id="stroke" min="1" max="10" value="2">
                </div>
                <div class="control-group">
                    <div class="control-header"><label data-en="Radius" data-cn="半径">Radius</label><span id="valRadius">200</span></div>
                    <input type="range" id="radius" min="50" max="280" value="200">
                </div>
                <!-- Color Palette Selection -->
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;" data-en="Color Palette" data-cn="调色板">Color Palette</label>
                <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                    <!-- Ming Porcelain (Default) -->
                    <button class="palette-btn active-palette" data-palette="ming" style="flex: 1; padding: 8px; border: 2px solid #1a1a1a; border-radius: 8px; background: #ffffff; cursor: pointer; transition: 0.2s; display: flex; flex-direction: column; align-items: center;">
                        <div style="display: flex; gap: 4px; margin-bottom: 4px;">
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #1a1a1a;"></span>
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #2a52be;"></span>
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #faf9f6; border: 1px solid #ccc;"></span>
                        </div>
                        <span style="font-size: 0.75rem; font-weight: 600; color: #333;" data-en="Ming" data-cn="明代">Ming</span>
                    </button>

                    <!-- Imperial Silk -->
                    <button class="palette-btn" data-palette="imperial" style="flex: 1; padding: 8px; border: 2px solid transparent; border-radius: 8px; background: #ffffff; cursor: pointer; transition: 0.2s; display: flex; flex-direction: column; align-items: center;">
                        <div style="display: flex; gap: 4px; margin-bottom: 4px;">
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #e63946;"></span>
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #d4af37;"></span>
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #faf9f6; border: 1px solid #ccc;"></span>
                        </div>
                        <span style="font-size: 0.75rem; font-weight: 600; color: #333;" data-en="Imperial" data-cn="皇家">Imperial</span>
                    </button>

                    <!-- Bamboo Forest -->
                    <button class="palette-btn" data-palette="bamboo" style="flex: 1; padding: 8px; border: 2px solid transparent; border-radius: 8px; background: #ffffff; cursor: pointer; transition: 0.2s; display: flex; flex-direction: column; align-items: center;">
                        <div style="display: flex; gap: 4px; margin-bottom: 4px;">
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #2e8b57;"></span>
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #1a1a1a;"></span>
                            <span style="width: 12px; height: 12px; border-radius: 50%; background: #faf9f6; border: 1px solid #ccc;"></span>
                        </div>
                        <span style="font-size: 0.75rem; font-weight: 600; color: #333;" data-en="Bamboo" data-cn="竹林">Bamboo</span>
                    </button>
                </div>
                <button class="btn-random" id="randomBtn" style="width: 100%; background-color: #f0f0f0; color: #1a1a1a; border: none; padding: 16px; font-size: 1rem; font-weight: 600; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; margin-bottom: 10px;" data-en="🎲 Randomize Pattern" data-cn="🎲 随机生成图案">
                    🎲 Randomize Pattern
                </button>
            </div>

            <div id="panelBrush" style="display: none;">
                <p style="font-size: 0.9rem; color: #666; margin-bottom: 20px;" data-en="Click and drag on the canvas to draw." data-cn="在画布上点击并拖动以进行绘制。">Click and drag on the canvas to draw.</p>

                <!-- Brush Type Selection -->
                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;" data-en="Brush Type" data-cn="笔刷类型">Brush Type</label>
                <div style="display: flex; gap: 10px; margin-bottom: 20px;">
                    <button class="brush-btn active-brush" data-brush="fine" style="flex: 1; padding: 10px; border: 2px solid #1a1a1a; border-radius: 8px; background: #ffffff; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: 0.2s; text-align: center;">
                        🖌️ <br> Fine
                    </button>
                    <button class="brush-btn" data-brush="broad" style="flex: 1; padding: 10px; border: 2px solid transparent; border-radius: 8px; background: #ffffff; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: 0.2s; text-align: center;">
                        🖍️ <br> Broad
                    </button>
                    <button class="brush-btn" data-brush="dry" style="flex: 1; padding: 10px; border: 2px solid transparent; border-radius: 8px; background: #ffffff; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: 0.2s; text-align: center;">
                        🌾 <br> Dry
                    </button>
                </div>

                <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 10px; display: block;" data-en="Ink Color" data-cn="墨水颜色">Ink Color</label>
                <div style="display: flex; gap: 15px; margin-bottom: 20px;">
                    <button class="color-btn active-color" data-color="#1a1a1a" style="width: 40px; height: 40px; border-radius: 50%; background-color: #1a1a1a; border: 2px solid #e63946; cursor: pointer;"></button>
                    <button class="color-btn" data-color="#e63946" style="width: 40px; height: 40px; border-radius: 50%; background-color: #e63946; border: 2px solid transparent; cursor: pointer;"></button>
                    <button class="color-btn" data-color="#2a52be" style="width: 40px; height: 40px; border-radius: 50%; background-color: #2a52be; border: 2px solid transparent; cursor: pointer;"></button>
                </div>

                <button id="eraserBtn" style="width: 100%; background-color: #ffffff; color: #1a1a1a; border: 1px solid #eaeaea; padding: 12px; font-size: 0.95rem; font-weight: 600; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; margin-bottom: 10px;" data-en="🧽 Eraser" data-cn="🧽 橡皮擦">
                    🧽 Eraser
                </button>
                <button id="clearCanvasBtn" style="width: 100%; background-color: #f0f0f0; color: #1a1a1a; border: none; padding: 16px; font-size: 1rem; font-weight: 600; border-radius: 8px; cursor: pointer; transition: all 0.2s ease; margin-bottom: 10px;" data-en="🗑 Clear Canvas" data-cn="🗑 清空画布">
                    🗑 Clear Canvas
                </button>
            </div>

            <button class="btn-save" id="saveBtn" style="margin-top: 10px;" data-en="Save Masterpiece" data-cn="保存杰作">Save Masterpiece</button>
            <a href="/Studio/Gallery" style="display: block; text-align: center; margin-top: 15px; color: #666; text-decoration: none; font-size: 0.9rem;" data-en="View Gallery &rarr;" data-cn="查看画廊 &rarr;">View Gallery &rarr;</a>
            <div id="statusMsg" class="status-msg"></div>
        </div>

        <div class="canvas-panel fade-up-element delay-3" style="flex-direction: column; gap: 20px;">
            <div id="canvasWrapper">
                <canvas id="drawingCanvas"></canvas>
                <canvas id="pencilCanvas"></canvas>
                <!-- Philosophy Quote Overlay -->
                <div style="position: absolute; bottom: 15px; right: 15px; z-index: 5; pointer-events: none; text-align: right; opacity: 0.6;">
                    <div style="font-family: 'Playfair Display', serif; font-size: 1.2rem; color: #1a1a1a; margin-bottom: 5px;">☯</div>
                    <div style="font-size: 0.75rem; color: #666; max-width: 200px; line-height: 1.3;" data-en="Like in traditional painting, empty space is as important as what is drawn." data-cn="就像传统绘画一样，空白与画出的内容同样重要。">
                        Like in traditional painting, empty space is as important as what is drawn.
                    </div>
                </div>
            </div>
            <!-- Action Buttons -->
            <div style="display: flex; gap: 10px; margin-top: 20px;">
                <a href="#" id="downloadBtn" style="flex: 1; text-align: center; color: #666; text-decoration: none; font-size: 0.9rem; font-weight: 500; border: 1px solid #eaeaea; padding: 10px 20px; border-radius: 30px; transition: all 0.2s ease; background: #ffffff;" data-en="⬇ Download PNG" data-cn="⬇ 下载 PNG">
                    ⬇ Download PNG
                </a>
                <button id="shareBtn" style="flex: 1; color: #1a1a1a; text-decoration: none; font-size: 0.9rem; font-weight: 500; border: 1px solid #eaeaea; background: #ffffff; padding: 10px 20px; border-radius: 30px; transition: all 0.2s ease; cursor: pointer;" data-en="🔗 Share" data-cn="🔗 分享">
                    🔗 Share
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Examples Showcase / Storytelling -->
<div style="max-width: 1100px; margin: 100px auto; padding: 0 20px;">
    <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: 2.5rem; font-weight: 600; color: #1a1a1a;" data-en="Inspiration from our Studio" data-cn="来自我们工作室的灵感">Inspiration from our Studio</h2>
        <p style="color: #666; font-size: 1.1rem;" data-en="Bridging the gap between ancient traditions and modern code." data-cn="弥合古老传统与现代代码之间的鸿沟。">Bridging the gap between ancient traditions and modern code.</p>
    </div>

    <!-- BLOCK 1: Generator -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 40px; margin-bottom: 120px; flex-wrap: wrap; position: relative;">
        <div style="flex: 0 1 450px; background: #ffffff; padding: 30px; border-radius: 20px; border: 1px solid #eaeaea; box-shadow: 0 10px 40px rgba(0,0,0,0.03);">
            <svg viewBox="0 0 200 200" style="width: 100%; height: auto;">
                <g stroke="#1a1a1a" stroke-width="2" fill="none" transform="translate(100,100)">
                    <circle cx="0" cy="0" r="50" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(0)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(45)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(90)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(135)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(180)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(225)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(270)" />
                    <path d="M0,0 Q40,-40 0,-80 Q-40,-40 0,0" transform="rotate(315)" />
                </g>
            </svg>
        </div>

        <div class="center-dot"></div>

        <div style="flex: 0 1 450px;">
            <div style="display: inline-block; background: #f0f0f0; color: #1a1a1a; padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px;" data-en="Generator Mode" data-cn="生成器模式">Generator Mode</div>
            <h3 style="font-size: 2rem; font-weight: 700; color: #1a1a1a; margin-bottom: 20px; line-height: 1.2;" data-en="The Art of Perfect Symmetry" data-cn="完美对称的艺术">The Art of Perfect Symmetry</h3>
            <p style="color: #555; font-size: 1.05rem; line-height: 1.7; margin-bottom: 15px;" data-en="In traditional Chinese culture, symmetry represents the balance of Yin and Yang—the harmony between light and dark, heaven and earth." data-cn="在中国传统文化中，对称代表着阴阳的平衡——光明与黑暗、天与地的和谐。">
                In traditional Chinese culture, symmetry represents the balance of <b>Yin and Yang</b>—the harmony between light and dark, heaven and earth.
            </p>
            <p style="color: #555; font-size: 1.05rem; line-height: 1.7;" data-en="Our generator draws inspiration from ancient paper-cutting (Jianzhi) and intricate porcelain patterns. By manipulating mathematical parameters, you are echoing the cosmic order that ancient artisans sought to capture." data-cn="我们的生成器从古老的剪纸艺术和精致的瓷器图案中汲取灵感。通过操纵数学参数，您正在呼应古代工匠试图捕捉的宇宙秩序。">
                Our generator draws inspiration from ancient <b>paper-cutting (Jianzhi)</b> and intricate <b>porcelain patterns</b>. By manipulating mathematical parameters, you are echoing the cosmic order that ancient artisans sought to capture.
            </p>
        </div>
    </div>

    <!-- BLOCK 2: Ink Brush -->
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap-reverse; position: relative;">
        <div style="flex: 0 1 450px;">
            <div style="display: inline-block; background: #f0f0f0; color: #1a1a1a; padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px;" data-en="Ink Brush Mode" data-cn="水墨笔模式">Ink Brush Mode</div>
            <h3 style="font-size: 2rem; font-weight: 700; color: #1a1a1a; margin-bottom: 20px; line-height: 1.2;" data-en="The Spirit of the Brush" data-cn="毛笔的精神">The Spirit of the Brush</h3>
            <p style="color: #555; font-size: 1.05rem; line-height: 1.7; margin-bottom: 15px;" data-en="Unlike rigid geometry, the Ink Brush mode celebrates the beauty of imperfection. It emulates Chinese Calligraphy (Shufa) and Ink Wash painting (Guohua)." data-cn="与死板的几何图形不同，水墨笔模式赞美不完美的美感。它模仿中国书法和水墨画。">
                Unlike rigid geometry, the Ink Brush mode celebrates the beauty of imperfection. It emulates <b>Chinese Calligraphy (Shufa)</b> and <b>Ink Wash painting (Guohua)</b>.
            </p>
            <p style="color: #555; font-size: 1.05rem; line-height: 1.7;" data-en="Notice how the line thickness changes with your speed—just like a real brush loaded with ink. Draw with the spirit of the Four Gentlemen, capturing the fleeting energy of the moment." data-cn="注意线条粗细如何随您的速度变化——就像一把蘸满墨水的真正毛笔。带着四君子的精神绘制，捕捉瞬间的能量。">
                Notice how the line thickness changes with your speed—just like a real brush loaded with ink. Draw with the spirit of the <b>Four Gentlemen</b>, capturing the fleeting energy of the moment.
            </p>
        </div>

        <div class="center-dot"></div>

        <div style="flex: 0 1 450px; background: #ffffff; padding: 30px; border-radius: 20px; border: 1px solid #eaeaea; box-shadow: 0 10px 40px rgba(0,0,0,0.03);">
            <svg viewBox="0 0 200 200" style="width: 100%; height: auto;">
